APP_NAME="Clinica Vida Saudavel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Configuração do MySQL
MYSQL_ROOT_PASSWORD=secret_root_password
MYSQL_DATABASE=clinica
MYSQL_USER=clinica_user
MYSQL_PASSWORD=clinica_password
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_BACKUP_PASSWORD=backup_secret_password

# Conexão da Aplicação Laravel com o MySQL
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=clinica
DB_USERNAME=clinica_user
DB_PASSWORD=clinica_password

# Cache, Sessão e Filas no Redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379

# Evolution API WhatsApp
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=change_me_evolution_api_key

# Asaas Billing Gateway
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Teste de Carga (Apache Bench)
BASE_URL=http://nginx:80/